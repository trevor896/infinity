PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Sender account (Gmail example — use an App Password, not your normal login password)
# Create one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_SECURE=false

# Where contact form messages are delivered
CONTACT_RECEIVER_EMAIL=kutsvaraclever@outlook.com

# Outlook sender alternative (instead of Gmail):
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=kutsvaraclever@outlook.com
# SMTP_PASS=your-outlook-app-password
# SMTP_SECURE=false
